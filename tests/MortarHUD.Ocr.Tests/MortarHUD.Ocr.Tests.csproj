<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MortarHUD.Ocr.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MortarHUD.Core\MortarHUD.Core.csproj" />
    <ProjectReference Include="..\..\src\MortarHUD.Capture\MortarHUD.Capture.csproj" />
  </ItemGroup>

  <!--
    OCR 测试直接跑真实截图 fixture，所以语言包和字形库必须一起带到测试输出目录。
  -->
  <ItemGroup>
    <None Include="..\..\src\MortarHUD.App\Models\**\*"
          Link="Models\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
