<Project Sdk="Microsoft.NET.Sdk">

  <!--
    所有 Win32 互操作集中在这里，其它项目不直接 P/Invoke。
    这样 Core 保持可移植，Capture/App 只依赖接口。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MortarHUD.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MortarHUD.Localization\MortarHUD.Localization.csproj" />
  </ItemGroup>

</Project>
