<UserControl x:Class="MortarHUD.App.Views.ColorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 颜色预览：棋盘底纹 + 实际颜色，透明色也能看出来 -->
        <Border Grid.Column="0"
                Height="24"
                Margin="0,0,6,0"
                BorderBrush="#3A3D42"
                BorderThickness="1"
                CornerRadius="3">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FF3A3A3A">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,8,8" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#FF5A5A5A">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,4,4" />
                                        <RectangleGeometry Rect="4,4,4,4" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <Border x:Name="Swatch" CornerRadius="2" Background="{Binding ColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <TextBox Grid.Column="1"
                 x:Name="HexBox"
                 VerticalContentAlignment="Center"
                 ToolTip="支持 #RRGGBB、#AARRGGBB，也支持 RRGGBB / AARRGGBB"
                 Text="{Binding ColorHex, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}" />

        <ToggleButton Grid.Column="2"
                      x:Name="PaletteToggle"
                      Margin="4,0,0,0"
                      Padding="6,2,6,2"
                      Content="▾"
                      ToolTip="从调色板选一个颜色" />

        <Popup Grid.Column="0" Grid.ColumnSpan="3"
               IsOpen="{Binding IsChecked, ElementName=PaletteToggle, Mode=TwoWay}"
               StaysOpen="False"
               PlacementTarget="{Binding ElementName=PaletteToggle}"
               Placement="Bottom"
               AllowsTransparency="True">
            <Border Background="#26282C" BorderBrush="#3A3D42" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel>
                    <TextBlock Text="常用色" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,6" />
                    <ItemsControl x:Name="SwatchList" Width="240">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="不透明度" FontSize="11" Foreground="#9AA0A6" Margin="0,10,0,4" />
                    <!--
                        事件在构造函数里挂，不写在 XAML 上：
                        带 Value 默认值的元素在 InitializeComponent() 期间就会引发一次事件，
                        那时其它具名元素可能还没建好。SettingsWindow 就栽在这上面。
                    -->
                    <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" Value="255" Width="240" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
