<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:MortarHUD.App.Localization" xmlns:views="clr-namespace:MortarHUD.App.Views" xmlns:vm="clr-namespace:MortarHUD.App.ViewModels" x:Class="MortarHUD.App.Views.SettingsWindow" Title="{loc:T MortarHUDSettings}" Width="1040" Height="800" MinWidth="920" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI" FontSize="13" Icon="/Assets/MortarHUD.ico"
                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <views:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <views:InverseBoolConverter x:Key="InverseBool"/>
    <views:ColorHexToBrushConverter x:Key="ColorHexToBrush"/>
    <views:HotkeyDisplayConverter x:Key="HotkeyDisplay"/>
  <views:SettingLabelConverter x:Key="SettingLabel"/></Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceRaisedBrush}" Padding="26,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/MortarHUD.png" Width="22" Height="22" Margin="0,0,10,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MortarHUD" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:T WARDOGSMortarCoordinateSolver}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- 底部操作条 -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="26,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{loc:T SettingsTakeEffectAfterYouClickApply}" Margin="0,0,18,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
          <CheckBox x:Name="LivePreviewCheck" Content="{loc:T LivePreview}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button Content="{loc:T Apply}" Click="OnApplyClicked"/>
          <Button Content="{loc:T SaveClose}" Click="OnOkClicked" Style="{StaticResource PrimaryButton}"/>
          <Button Content="{loc:T Collapse}" Click="OnCancelClicked" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="26,22,26,26" TabStripPlacement="Left">
      <TabItem Header="{loc:T DailyUse}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{loc:T LockTheGunRecordTheTarget}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:T UseItWithTheInGameMapOpenAFailedReadLeavesTheSav}" Style="{StaticResource Hint}"/>
            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{loc:T Hotkeys}" Style="{StaticResource SectionHeader}"/>
                  <Grid Margin="0,8,0,0" MaxWidth="10000" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:T RecordGun}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="GunHotkeyBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="OnHotkeyBoxKeyDown" PreviewMouseDown="OnHotkeyBoxMouseDown" GotFocus="OnHotkeyBoxGotFocus" Text="{Binding CaptureGun, Mode=OneWay, Converter={StaticResource HotkeyDisplay}}" AutomationProperties.Name="{loc:T RecordGun}"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:T RecordTarget}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TargetHotkeyBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="OnHotkeyBoxKeyDown" PreviewMouseDown="OnHotkeyBoxMouseDown" GotFocus="OnHotkeyBoxGotFocus" Text="{Binding CaptureTarget, Mode=OneWay, Converter={StaticResource HotkeyDisplay}}" AutomationProperties.Name="{loc:T RecordTarget}"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:T ShowHideHUD}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ToggleHotkeyBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="OnHotkeyBoxKeyDown" PreviewMouseDown="OnHotkeyBoxMouseDown" GotFocus="OnHotkeyBoxGotFocus" Text="{Binding ToggleHudHotkey, Mode=OneWay, Converter={StaticResource HotkeyDisplay}}" AutomationProperties.Name="{loc:T ShowHideHUD}"/>
                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:T OpenSettings}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="SettingsHotkeyBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="OnHotkeyBoxKeyDown" PreviewMouseDown="OnHotkeyBoxMouseDown" GotFocus="OnHotkeyBoxGotFocus" Text="{Binding OpenSettingsHotkey, Mode=OneWay, Converter={StaticResource HotkeyDisplay}}" AutomationProperties.Name="{loc:T OpenSettings}"/>
                    <Button Grid.Row="4" Grid.Column="1" Content="{loc:T RestoreDefaults}" Click="OnRestoreHotkeysClicked" HorizontalAlignment="Left" Margin="0,8,0,16"/>
                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                      <CheckBox Content="{loc:T AutoCalibrateTheGunWhenTheMapKeyIsPressed}" IsChecked="{Binding AutoCalibrateEnabled}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{loc:T MapKeyAutoCalibration}" Style="{StaticResource SectionHeader}"/>
                    <Label Grid.Row="7" Grid.Column="0" Content="{loc:T MapKey}"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="MapKeyBox" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="OnHotkeyBoxKeyDown" GotFocus="OnHotkeyBoxGotFocus" IsEnabled="{Binding AutoCalibrateEnabled}" Text="{Binding AutoCalibrateKey, Mode=OneWay, Converter={StaticResource HotkeyDisplay}}" AutomationProperties.Name="{loc:T MapKey}"/>
                    <Label Grid.Row="8" Grid.Column="0" Content="{loc:T WaitAfterOpeningTheMap}"/>
                    <TextBox Grid.Row="8" Grid.Column="1" IsEnabled="{Binding AutoCalibrateEnabled}" Text="{Binding AutoCalibrateDelayMs}" AutomationProperties.Name="{loc:T WaitAfterOpeningTheMap}"/>
                    <TextBlock Grid.Row="8" Grid.Column="2" Text="{loc:T TextMs}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <!-- 这一行是给布局留位置的，内容由上面的 StackPanel 提供 -->
                    <TextBlock Grid.Row="6" Grid.Column="1" Visibility="Collapsed"/>
                  </Grid>
                  <TextBlock Text="{loc:T ClickAHotkeyBoxThenPressTheNewKeyAfterPressingMK}" Style="{StaticResource Hint}"/>
                </StackPanel>
              </Border>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{loc:T HowToUse}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="{loc:T OpenTheMapAndLockTheGun}" Margin="0,12,0,8"/>
                    <TextBlock Text="{loc:T PointAtTheTargetAndPressTheTargetKey}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:T ReadAZAndRNGFromTheHUD}" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:T MAutoCalibrationOnlyFiresWhileTheCursorIsBackAtT}" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </Border>
                <StackPanel>
                  <TextBlock Text="{loc:T Startup}" Style="{StaticResource SectionHeader}"/>
                  <CheckBox Content="{loc:T StartMinimizedToTray}" IsChecked="{Binding StartMinimized}"/>
                  <CheckBox Content="{loc:T StartWithWindows}" IsChecked="{Binding StartWithWindows}"/>
                  <TextBlock Text="{loc:T ClosingTheWindowKeepsMortarHUDRunningInTheSystem}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                  <TextBlock Text="{loc:T Language}" Style="{StaticResource SectionHeader}" Margin="0,16,0,0"/>
                  <!--
                    语言名不翻译：中文就叫「中文」，英文就叫 English——
                    把语言名译成当前语言会让用户找不到自己想切的那一项。
                  -->
                  <ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag"
                            Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="中文" Tag="zh-CN"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                  </ComboBox>
                  <TextBlock Text="{loc:T LanguageHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                  <Expander Header="{loc:T CoordinateConversionAndAxes}">
                    <StackPanel>
                      <TextBlock Text="{loc:T CoordinateConversion}" Style="{StaticResource SectionHeader}"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{loc:T MetersPerCoordinateUnit}"/>
                        <TextBox Grid.Column="1" Text="{Binding MetersPerCoordinateUnit, StringFormat={}{0:0.###}}" AutomationProperties.Name="{loc:T MetersPerCoordinateUnit}"/>
                        <Label Grid.Column="2" Content="{loc:T TextM}"/>
                      </Grid>
                      <TextBlock Text="{loc:T AxisDirections}" Style="{StaticResource SectionHeader}"/>
                      <CheckBox Content="{loc:T XPointsEast}" IsChecked="{Binding XPositiveIsEast}"/>
                      <CheckBox Content="{loc:T YPointsNorth}" IsChecked="{Binding YPositiveIsNorth}"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:T Appearance}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="290"/>
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{loc:T CrispWithoutBeingLoud}" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="{loc:T StartFromAPresetThePreviewOnTheRightUpdatesLive}" Style="{StaticResource Hint}"/>
              <TextBlock Text="{loc:T ThemePresets}" Style="{StaticResource SectionHeader}"/>
              <DockPanel Margin="0,6,0,12">
                <Button DockPanel.Dock="Right" Content="{loc:T UsePreset}" Click="OnApplyThemeClicked" Margin="10,0,0,0"/>
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              </DockPanel>
              <TextBlock Text="{loc:T SizeAndLayout}" Style="{StaticResource SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="{loc:T Layout}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableLayouts}" SelectedItem="{Binding Layout}" AutomationProperties.Name="{loc:T Layout}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <Label Grid.Row="1" Grid.Column="0" Content="{loc:T FontSize}"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T FontSize}"/>
              </Grid>
              <TextBlock Text="{loc:T Position}" Style="{StaticResource SectionHeader}"/>
              <CheckBox x:Name="UnlockPositionCheck" Content="{loc:T UnlockThePositionAndDragTheHUD}" IsChecked="{Binding PositionUnlocked}" Checked="OnUnlockPositionToggled" Unchecked="OnUnlockPositionToggled" Margin="0,8,0,8"/>
              <Expander Header="{loc:T ExactPosition}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:T Anchor}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableAnchors}" SelectedItem="{Binding Anchor}" AutomationProperties.Name="{loc:T Anchor}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:T OffsetX}"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-400" Maximum="400" Value="{Binding OffsetX}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T OffsetX}"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:T OffsetY}"/>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="-400" Maximum="400" Value="{Binding OffsetY}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T OffsetY}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="{loc:T ResetPosition}" Click="OnResetPositionClicked" Margin="16,0,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Expander>
              <Expander Header="{loc:T FontColorAndEffects}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:T Font}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableFonts}" SelectedItem="{Binding FontFamily}" AutomationProperties.Name="{loc:T Font}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:T Weight}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableFontWeights}" SelectedItem="{Binding FontWeight}" AutomationProperties.Name="{loc:T Weight}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="4" Grid.Column="0" Content="{loc:T LetterSpacing}"/>
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="8" Value="{Binding LetterSpacing}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T LetterSpacing}"/>
                    <Label Grid.Row="5" Grid.Column="0" Content="{loc:T LineHeight}"/>
                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0.8" Maximum="2.5" Value="{Binding LineHeight}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T LineHeight}"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="{loc:T Alignment}"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableAlignments}" SelectedItem="{Binding Alignment}" AutomationProperties.Name="{loc:T Alignment}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:T Primary}"/>
                    <views:ColorEditor Grid.Row="0" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding PrimaryColor}"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:T Secondary}"/>
                    <views:ColorEditor Grid.Row="1" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding SecondaryColor}"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:T SuccessColor}"/>
                    <views:ColorEditor Grid.Row="2" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding SuccessColor}"/>
                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:T WarningColor}"/>
                    <views:ColorEditor Grid.Row="3" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding WarningColor}"/>
                    <Label Grid.Row="4" Grid.Column="0" Content="{loc:T ErrorColor}"/>
                    <views:ColorEditor Grid.Row="4" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding ErrorColor}"/>
                    <Label Grid.Row="5" Grid.Column="0" Content="{loc:T OutlineColor}"/>
                    <views:ColorEditor Grid.Row="5" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding OutlineColor}"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="{loc:T ShadowColor}"/>
                    <views:ColorEditor Grid.Row="6" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding ShadowColor}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="{loc:T TextOutline}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableOutlines}" SelectedItem="{Binding Outline}" AutomationProperties.Name="{loc:T TextOutline}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="1" Grid.Column="0" Content="{loc:T OutlineThickness}"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="4" Value="{Binding OutlineThickness}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T OutlineThickness}"/>
                    <Label Grid.Row="2" Grid.Column="0" Content="{loc:T Shadow}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableShadows}" SelectedItem="{Binding Shadow}" AutomationProperties.Name="{loc:T Shadow}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="3" Grid.Column="0" Content="{loc:T Background}"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableBackgrounds}" SelectedItem="{Binding Background}" AutomationProperties.Name="{loc:T Background}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Label Grid.Row="4" Grid.Column="0" Content="{loc:T BackgroundColor}"/>
                    <views:ColorEditor Grid.Row="4" Grid.Column="1" Margin="0,3,0,3" ColorHex="{Binding BackgroundColor}"/>
                    <Label Grid.Row="5" Grid.Column="0" Content="{loc:T BackgroundOpacity}"/>
                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T BackgroundOpacity}"/>
                    <Label Grid.Row="6" Grid.Column="0" Content="{loc:T OverallOpacity}"/>
                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding Opacity}" ToolTip="{Binding Value, RelativeSource={RelativeSource Self}, StringFormat={}{0:0.##}}" AutomationProperties.Name="{loc:T OverallOpacity}"/>
                  </Grid>
                </StackPanel>
              </Expander>
              <Expander Header="{loc:T ContentAndPrecision}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{loc:T ShowAZ}" IsChecked="{Binding ShowAz}" Margin="0,0,16,0"/>
                    <CheckBox Content="{loc:T ShowRNG}" IsChecked="{Binding ShowRng}" Margin="0,0,16,0"/>
                    <CheckBox Content="{loc:T ShowGun}" IsChecked="{Binding ShowGun}" Margin="0,0,16,0"/>
                    <CheckBox Content="{loc:T ShowTarget}" IsChecked="{Binding ShowTarget}"/>
                  </StackPanel>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="60"/>
                      <ColumnDefinition Width="40"/>
                      <ColumnDefinition Width="60"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{loc:T AzimuthDecimals}"/>
                    <TextBox Grid.Column="1" Text="{Binding BearingDecimals}" AutomationProperties.Name="{loc:T AzimuthDecimals}"/>
                    <Label Grid.Column="2" Content="{loc:T Range}"/>
                    <TextBox Grid.Column="3" Text="{Binding RangeDecimals}" AutomationProperties.Name="{loc:T Range}"/>
                  </Grid>
                </StackPanel>
              </Expander>
              <Expander Header="{loc:T ManageCustomThemes}">
                <WrapPanel>
                  <Button Content="{loc:T Apply}" Click="OnApplyThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T SaveAs}" Click="OnDuplicateThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T Rename}" Click="OnRenameThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T Overwrite}" Click="OnOverwriteThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T Delete}" Click="OnDeleteThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T Import}" Click="OnImportThemeClicked" Margin="0,4,8,4"/>
                  <Button Content="{loc:T Export}" Click="OnExportThemeClicked" Margin="0,4,8,4"/>
                </WrapPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T HUDPreview}" Style="{StaticResource SectionHeader}"/>
            <Border Background="{StaticResource SurfaceSunkenBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
              <Grid>
                <TextBlock Text="{loc:T SampleCoordinatesAppliedInGameAfterSaving}" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" FontSize="11"/>
                <views:HudRenderer x:Name="PreviewRenderer" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </Grid>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="炮口标尺">
        <views:RulerSettingsPanel x:Name="RulerPanel"/>
      </TabItem>
      <TabItem Header="{loc:T Diagnostics}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{loc:T KeepTheEvidenceFindTheCause}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{loc:T OnlyTheSmallAreaAroundTheCursorIsSavedAllDiagnos}" Style="{StaticResource Hint}"/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,12">
              <StackPanel>
                <TextBlock Text="{loc:T OccasionalReadFailures}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:T AfterEnablingGoBackToTheGameAndReproduceWithTheH}" Style="{StaticResource Hint}" Margin="0,8,0,16"/>
                <WrapPanel>
                  <Button Content="{loc:T CollectTheNext10Captures}" Click="OnCollectDiagnosticsClicked" Style="{StaticResource PrimaryButton}"/>
                  <Button Content="{loc:T OpenDiagnosticsFolder}" Click="OnOpenDebugFolderClicked"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Expander Header="{loc:T RecognitionAdvanced}">
              <StackPanel>
                <TextBlock Text="{loc:T EngineAndPreprocessing}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Grid.Column="0" Content="{loc:T OCREngine}"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailableEngines}" SelectedItem="{Binding OcrEngine}" AutomationProperties.Name="{loc:T OCREngine}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <Label Grid.Row="1" Grid.Column="0" Content="{loc:T Preprocessed}"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" ItemsSource="{x:Static vm:SettingsViewModel.AvailablePreprocessors}" SelectedItem="{Binding Preprocessor}" AutomationProperties.Name="{loc:T Preprocessed}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SettingLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <Label Grid.Row="2" Grid.Column="0" Content="{loc:T TessdataPath}"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,2" Text="{Binding TessdataPath}" ToolTip="{loc:T LeaveEmptyToUseModelsTessdataNextToTheExecutable}" AutomationProperties.Name="{loc:T TessdataPath}"/>
                </Grid>
                <TextBlock Text="{loc:T CursorInsideTheROI}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Grid.Column="0" Content="{loc:T Width}"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RoiWidth}" AutomationProperties.Name="{loc:T Width}"/>
                  <Label Grid.Row="0" Grid.Column="2" Content="{loc:T Height}"/>
                  <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding RoiHeight}" AutomationProperties.Name="{loc:T Height}"/>
                  <Label Grid.Row="1" Grid.Column="0" Content="{loc:T OffsetX}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RoiOffsetX}" AutomationProperties.Name="{loc:T OffsetX}"/>
                  <Label Grid.Row="1" Grid.Column="2" Content="{loc:T OffsetY}"/>
                  <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RoiOffsetY}" AutomationProperties.Name="{loc:T OffsetY}"/>
                  <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="{loc:T ScaleWithResolution}" IsChecked="{Binding RoiAutoScale}"/>
                  <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RoiScale}" IsEnabled="{Binding RoiAutoScale, Converter={StaticResource InverseBool}}"/>
                </Grid>
                <TextBlock Text="{loc:T ValidationThresholds}" Style="{StaticResource SectionHeader}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Grid.Column="0" Content="{loc:T CoordinateMin}"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CoordinateMin}" AutomationProperties.Name="{loc:T CoordinateMin}"/>
                  <Label Grid.Row="0" Grid.Column="2" Content="{loc:T CoordinateMax}"/>
                  <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CoordinateMax}" AutomationProperties.Name="{loc:T CoordinateMax}"/>
                  <Label Grid.Row="1" Grid.Column="0" Content="{loc:T MinimumConfidence}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumConfidence}" AutomationProperties.Name="{loc:T MinimumConfidence}"/>
                  <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="{loc:T RequireADecimalPoint}" IsChecked="{Binding RequireDecimalPoint}"/>
                </Grid>
              </StackPanel>
            </Expander>
            <Expander Header="{loc:T InspectASingleRecognition}">
              <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T OneShotRecognitionTest}" Style="{StaticResource SectionHeader}"/>
                <Button DockPanel.Dock="Top" Content="{loc:T TestingIn3SecondsAndSavingImages}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnTestOcrClicked"/>
                <Border DockPanel.Dock="Bottom" Padding="8">
                        </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock x:Name="TestRawLabel" Text="{loc:T RawROI}" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="80">
                      <Image x:Name="TestRawImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{loc:T PreprocessedResult}" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="80">
                      <Image x:Name="TestProcessedImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{loc:T RecognitionResult}" Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="TestResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Text="{loc:T NotTestedYetTheCursorMustBePointingAtTheCoordina}"/>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Expander>
            <Expander Header="{loc:T OngoingDebugAndHUDDiagnostics}">
              <StackPanel MaxWidth="10000" HorizontalAlignment="Stretch">
                <TextBlock Text="{loc:T MasterSwitch}" Style="{StaticResource SectionHeader}"/>
                <CheckBox Content="{loc:T EnableDebugMode}" IsChecked="{Binding DebugEnabled}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:T WhatToShow}" Style="{StaticResource SectionHeader}"/>
                <CheckBox Content="{loc:T ShowROIRectangle}" IsChecked="{Binding ShowRoiRectangle}"/>
                <CheckBox Content="{loc:T ShowCursorAnchor}" IsChecked="{Binding ShowCursorAnchor}"/>
                <CheckBox Content="{loc:T ShowRawOCRText}" IsChecked="{Binding ShowRawOcrText}"/>
                <CheckBox Content="{loc:T ShowParsedCoordinates}" IsChecked="{Binding ShowParsedCoordinates}"/>
                <CheckBox Content="{loc:T ShowConfidence}" IsChecked="{Binding ShowConfidence}"/>
                <CheckBox Content="{loc:T ShowTiming}" IsChecked="{Binding ShowTiming}"/>
                <TextBlock Text="{loc:T SavedToDisk}" Style="{StaticResource SectionHeader}"/>
                <CheckBox Content="{loc:T SaveRawROI}" IsChecked="{Binding SaveRawRoi}"/>
                <CheckBox Content="{loc:T SavePreprocessedResult}" IsChecked="{Binding SaveProcessedRoi}"/>
                <Button Content="{loc:T OpenDebugFolder}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenDebugFolderClicked"/>

                <TextBlock Text="{loc:T BaselineSampling}" Style="{StaticResource SectionHeader}"/>
                <CheckBox Content="{loc:T AlsoSaveTheFullScreenCursorPositionOnEveryCaptur}" IsChecked="{Binding SaveFullFrame}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="{loc:T UsedToCalibrateTheDefaultROITheFullScreenAndTheC}"/>
                <Button Content="{loc:T OpenSampleFolder}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenSamplesFolderClicked"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
